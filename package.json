{
  "name": "finance-kaoyan-app",
  "version": "1.3.2",
  "description": "金融考研择校通",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-renderer.js && node tools/test-migration.js && node tools/test-web-mode.js",
    "build:web": "node tools/build-web.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.kaoyan.finance",
    "productName": "金融考研择校通",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "data/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.1.0"
  }
}
